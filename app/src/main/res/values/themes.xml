<resources>
    <style name="Theme.JARVIS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/jarvis_primary</item>
        <item name="colorOnPrimary">@color/jarvis_on_primary</item>
        <item name="colorSecondary">@color/jarvis_secondary</item>
        <item name="colorOnSecondary">@color/jarvis_on_secondary</item>
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="colorOnSurface">@color/jarvis_on_surface</item>
        <item name="colorBackground">@color/jarvis_background</item>
        <item name="colorOnBackground">@color/jarvis_on_background</item>
    </style>

    <style name="Theme.JARVIS.NoActionBar" parent="Theme.JARVIS">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.JARVIS.FullScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/jarvis_black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">false</item>
    </style>
</resources>
